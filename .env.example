APP_NAME=Proformas
# Versión que muestra la pantalla "Estado del sistema" del superusuario.
APP_VERSION=1.0.0
EMPRESA_DEFAULT_ID=1
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_BO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=proformas
DB_USERNAME=proformas
DB_PASSWORD=proformas
# Reutiliza la conexión a PostgreSQL. Recomendado en Windows (cada conexión nueva cuesta ~130 ms).
DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_COOKIE=laravel-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_MAX_AGE=3600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo (envío de proformas, aviso de orden finalizada y verificación del
# correo del cliente). Con MAIL_MAILER=log los correos NO salen: quedan en
# storage/logs/laravel.log (útil en desarrollo). Las pruebas usan el mailer
# de prueba (array) y nunca envían correos reales.
#
# Gmail (cuenta con verificación en dos pasos):
#   1. En https://myaccount.google.com/apppasswords crea una "contraseña de
#      aplicación" de 16 caracteres (no uses tu contraseña normal).
#   2. Configura:
#      MAIL_MAILER=smtp
#      MAIL_SCHEME=null
#      MAIL_HOST=smtp.gmail.com
#      MAIL_PORT=587
#      MAIL_USERNAME=tu.cuenta@gmail.com
#      MAIL_PASSWORD=la_contraseña_de_aplicación
#      MAIL_FROM_ADDRESS=tu.cuenta@gmail.com
#   Gmail limita los envíos (unos 500 por día) y exige que el remitente sea
#   la misma cuenta.
#
# Correo institucional (por ejemplo, el de la universidad o la empresa):
#   pide al área de sistemas el servidor SMTP, el puerto (587 con STARTTLS
#   o 465 con SSL; con 465 usa MAIL_SCHEME=smtps) y un usuario autorizado.
#      MAIL_MAILER=smtp
#      MAIL_HOST=smtp.tu-dominio.bo
#      MAIL_PORT=587
#      MAIL_USERNAME=proformas@tu-dominio.bo
#      MAIL_PASSWORD=...
#      MAIL_FROM_ADDRESS=proformas@tu-dominio.bo
#
# Si el envío falla, la proforma queda Enviada igual, el sistema muestra un
# aviso y el error queda en storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Dirección del front: los correos enlazan al portal con esta base.
FRONTEND_URL=http://localhost:3000

# "Continuar con Google" (opcional). Paso a paso en CONFIGURAR_GOOGLE.md.
# Sin GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET el botón no aparece.
# GOOGLE_REDIRECT_URI debe ser EXACTAMENTE la que se registró en Google
# Cloud Console: la dirección del FRONT seguida de /api/v1/auth/google/callback
# (si se deja vacía, se arma con FRONTEND_URL).
# Ejemplo local:      http://localhost:3000/api/v1/auth/google/callback
# Ejemplo publicado:  https://proformas.miempresa.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

ADMIN_PASSWORD=password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
